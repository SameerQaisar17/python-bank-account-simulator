import json
from datetime import datetime

FILE_NAME = "account_data.json"


def load_account():
    try:
        with open(FILE_NAME, "r") as file:
            return json.load(file)

    except FileNotFoundError:
        return None


def save_account(account):
    with open(FILE_NAME, "w") as file:
        json.dump(account, file, indent=4)


def create_account():
    print("\n===== CREATE BANK ACCOUNT =====")

    name = input("Enter account holder name: ").strip()

    if not name:
        print("Name cannot be empty!")
        return None

    account = {
        "holder": name,
        "balance": 0.0,
        "transactions": []
    }

    save_account(account)
    print("\nAccount created successfully!")

    return account


def view_account(account):
    print("\n===== ACCOUNT DETAILS =====")
    print(f"Account holder: {account['holder']}")
    print(f"Current balance: ${account['balance']:.2f}")


def deposit(account):
    print("\n===== DEPOSIT MONEY =====")

    try:
        amount = float(input("Enter deposit amount: $"))

        if amount <= 0:
            print("Amount must be greater than zero!")
            return

        account["balance"] += amount

        transaction = {
            "type": "Deposit",
            "amount": amount,
            "date": datetime.now().strftime("%d-%m-%Y %H:%M:%S")
        }

        account["transactions"].append(transaction)
        save_account(account)

        print(f"\nSuccessfully deposited ${amount:.2f}!")
        print(f"New balance: ${account['balance']:.2f}")

    except ValueError:
        print("Please enter a valid number!")


def withdraw(account):
    print("\n===== WITHDRAW MONEY =====")

    try:
        amount = float(input("Enter withdrawal amount: $"))

        if amount <= 0:
            print("Amount must be greater than zero!")
            return

        if amount > account["balance"]:
            print("Insufficient balance!")
            return

        account["balance"] -= amount

        transaction = {
            "type": "Withdrawal",
            "amount": amount,
            "date": datetime.now().strftime("%d-%m-%Y %H:%M:%S")
        }

        account["transactions"].append(transaction)
        save_account(account)

        print(f"\nSuccessfully withdrew ${amount:.2f}!")
        print(f"Remaining balance: ${account['balance']:.2f}")

    except ValueError:
        print("Please enter a valid number!")


def view_transactions(account):
    print("\n===== TRANSACTION HISTORY =====")

    if not account["transactions"]:
        print("No transactions found!")
        return

    for number, transaction in enumerate(
        account["transactions"], start=1
    ):
        print(f"\nTransaction {number}")
        print(f"Type: {transaction['type']}")
        print(f"Amount: ${transaction['amount']:.2f}")
        print(f"Date: {transaction['date']}")


def main():
    account = load_account()

    while True:
        print("\n===== BANK ACCOUNT SIMULATOR =====")
        print("1. Create account")
        print("2. View account")
        print("3. Deposit money")
        print("4. Withdraw money")
        print("5. View transaction history")
        print("6. Exit")

        choice = input("\nChoose an option (1-6): ").strip()

        if choice == "1":
            if account is None:
                account = create_account()
            else:
                print("An account already exists!")

        elif choice == "2":
            if account:
                view_account(account)
            else:
                print("Please create an account first!")

        elif choice == "3":
            if account:
                deposit(account)
            else:
                print("Please create an account first!")

        elif choice == "4":
            if account:
                withdraw(account)
            else:
                print("Please create an account first!")

        elif choice == "5":
            if account:
                view_transactions(account)
            else:
                print("Please create an account first!")

        elif choice == "6":
            print("\nThank you for using Bank Account Simulator!")
            break

        else:
            print("\nInvalid choice! Please select 1-6.")


if __name__ == "__main__":
    main()